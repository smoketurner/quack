# syntax=docker/dockerfile:1
#
# Reproducible static musl binaries of `quack`, driven by docker-bake.hcl
# and, in the release workflow, a matrix that sets TARGET per runner
# architecture. This does not replace the runtime image in `Dockerfile`.
#
# cargo-chef caches dependency compilation (DuckDB, aws-lc): only the
# workspace crates recompile when the source changes, as long as
# Cargo.toml and Cargo.lock are stable. The web UI's CSS is committed
# (`make css-build`), so there is no Tailwind stage here.

# Keep this Rust version in sync with rust-toolchain.toml.
FROM rust:1.98.0-alpine AS base
# DuckDB (C++) and aws-lc-rs build from source on musl. No openssl: aws-lc-rs
# is the only crypto provider (deny.toml bans openssl and ring).
RUN apk add --no-cache musl-dev pkgconfig cmake make perl clang linux-headers g++

RUN cargo install cargo-chef --locked

# --- Planner: the dependency recipe ---
FROM base AS planner
WORKDIR /app
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# --- Builder: cook the dependencies, then build the workspace ---
FROM base AS builder

ARG TARGET

WORKDIR /app
RUN rustup target add "${TARGET}"

COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --release --locked --target "${TARGET}" --package quack --recipe-path recipe.json

COPY . .

# Declared after the cook layer so changes do not bust the cache.
ARG SOURCE_DATE_EPOCH=0
ARG GENERATE_SBOM=false

RUN touch -d "@${SOURCE_DATE_EPOCH}" crates/quack-core/src/lib.rs crates/quack/src/main.rs

RUN cargo build --release --locked --target "${TARGET}" --package quack

RUN if [ "${GENERATE_SBOM}" = "true" ]; then \
      cargo install cargo-cyclonedx --version 0.5.6 --locked \
      && cargo cyclonedx --target "${TARGET}" --format json; \
    fi

# Only the binary and any SBOM go to /out.
RUN mkdir -p "/out/target/${TARGET}/release" \
    && cp "target/${TARGET}/release/quack" "/out/target/${TARGET}/release/" \
    && find crates/ -name "*cdx.json" 2>/dev/null | while read -r f; do \
         mkdir -p "/out/$(dirname "$f")"; \
         cp "$f" "/out/$f"; \
       done

FROM scratch AS output
COPY --from=builder /out/ /
