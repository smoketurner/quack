# Rust build output
/target
**/*.rs.bk

# Local databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Secrets / environment
.env
.env.*
!.env.example

# Tailwind CSS is built from styles/input.css with `make css-build` and committed
# (crates/quack/static/css/output.css) because rust-embed needs it at compile time
# and CI has no Tailwind binary.

# The SQL editor bundle's packages; the built bundle is committed
# (crates/quack/static/js/sql-editor.min.js, `make editor-build`).
crates/quack/editor/node_modules/

# Editor / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Working directory (agent handoffs, plans, testing)
.local/

# Mutation testing output (make test-mutants)
/mutants.out

# Claude Code local state
.claude/settings.local.json
.claude/worktrees/
