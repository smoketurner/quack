{
  "classes": [
    {
      "id": "episode",
      "label": "Episode",
      "description": "One weather system as a forecast office experienced it: a squall line, a winter storm, a hurricane's passage",
      "key": "episode_id",
      "properties": ["episode_id"]
    },
    {
      "id": "storm_event",
      "label": "Storm event",
      "description": "One kind of weather in one county or zone during an episode",
      "key": "event_id",
      "properties": [
        "event_id",
        "event_type",
        "begin_time",
        "county_zone",
        "deaths_direct",
        "injuries_direct",
        "damage_property_usd",
        "tornado_scale",
        "magnitude"
      ]
    },
    {
      "id": "fatality",
      "label": "Fatality",
      "description": "One person killed by a storm event, directly or indirectly",
      "key": "fatality_id",
      "properties": ["fatality_id", "fatality_type", "fatality_location", "fatality_age", "fatality_sex"]
    },
    {
      "id": "state",
      "label": "State",
      "description": "A state, the District of Columbia, Puerto Rico, or a marine area, as named in the events table",
      "key": "name",
      "properties": ["name", "fips", "region", "population_2024"]
    },
    {
      "id": "forecast_office",
      "label": "Weather Forecast Office",
      "description": "The National Weather Service office that recorded the event, by its three-letter identifier",
      "key": "wfo",
      "properties": ["wfo"]
    }
  ],
  "relations": [
    {
      "id": "part_of",
      "label": "part of",
      "description": "The episode the storm event belongs to",
      "domain": "storm_event",
      "range": "episode"
    },
    {
      "id": "occurred_in",
      "label": "occurred in",
      "description": "The state or marine area where the storm event happened",
      "domain": "storm_event",
      "range": "state"
    },
    {
      "id": "reported_by",
      "label": "reported by",
      "description": "The forecast office that wrote the entry",
      "domain": "storm_event",
      "range": "forecast_office"
    },
    {
      "id": "killed_in",
      "label": "killed in",
      "description": "The storm event the person died in",
      "domain": "fatality",
      "range": "storm_event"
    }
  ],
  "properties": [
    { "id": "episode_id", "type": "string" },
    { "id": "event_id", "type": "string" },
    { "id": "event_type", "label": "Event type", "type": "string" },
    { "id": "begin_time", "label": "Began", "type": "date" },
    { "id": "county_zone", "label": "County or zone", "type": "string" },
    { "id": "deaths_direct", "label": "Direct deaths", "type": "number" },
    { "id": "injuries_direct", "label": "Direct injuries", "type": "number" },
    { "id": "damage_property_usd", "label": "Property damage (USD)", "type": "number" },
    {
      "id": "tornado_scale",
      "label": "EF rating",
      "type": "enum",
      "values": ["EF0", "EF1", "EF2", "EF3", "EF4", "EF5", "EFU"]
    },
    { "id": "magnitude", "label": "Magnitude (knots or inches)", "type": "number" },
    { "id": "fatality_id", "type": "string" },
    { "id": "fatality_type", "label": "Direct or indirect", "type": "enum", "values": ["D", "I"] },
    { "id": "fatality_location", "label": "Where the person was", "type": "string" },
    { "id": "fatality_age", "label": "Age", "type": "number" },
    { "id": "fatality_sex", "label": "Sex", "type": "enum", "values": ["F", "M"] },
    { "id": "name", "type": "string" },
    { "id": "fips", "label": "FIPS code", "type": "string" },
    { "id": "region", "label": "Census region", "type": "string" },
    { "id": "population_2024", "label": "Population, 2024 estimate", "type": "number" },
    { "id": "wfo", "label": "WFO identifier", "type": "string" }
  ],
  "mappings": [
    {
      "table": "notable_events",
      "class": "storm_event",
      "key": "event_id",
      "properties": {
        "event_type": "event_type",
        "begin_time_ts": "begin_time",
        "cz_name": "county_zone",
        "deaths_direct": "deaths_direct",
        "injuries_direct": "injuries_direct",
        "damage_property_usd": "damage_property_usd",
        "tor_f_scale": "tornado_scale",
        "magnitude": "magnitude"
      },
      "relations": [
        { "relation": "part_of", "column": "episode_id", "target_class": "episode", "target_key": "episode_id" },
        { "relation": "occurred_in", "column": "state", "target_class": "state", "target_key": "name" },
        { "relation": "reported_by", "column": "wfo", "target_class": "forecast_office", "target_key": "wfo" }
      ]
    },
    {
      "table": "fatalities",
      "class": "fatality",
      "key": "FATALITY_ID",
      "properties": {
        "FATALITY_TYPE": "fatality_type",
        "FATALITY_LOCATION": "fatality_location",
        "FATALITY_AGE": "fatality_age",
        "FATALITY_SEX": "fatality_sex"
      },
      "relations": [
        { "relation": "killed_in", "column": "EVENT_ID", "target_class": "storm_event", "target_key": "event_id" }
      ]
    },
    {
      "table": "states",
      "class": "state",
      "key": "name",
      "properties": { "fips": "fips", "region": "region", "population_2024": "population_2024" }
    }
  ]
}
