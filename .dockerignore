# Deny by default: only what the image builds need, so the context stays
# small and cache-stable.

*

# Root build files
!Cargo.toml
!Cargo.lock

# Workspace crate manifests (the dependency caching layer)
!crates/quack-core/Cargo.toml
!crates/quack/Cargo.toml

# Source and compile-time assets
!crates/quack-core/src/
!crates/quack/src/
!crates/quack/templates/
!crates/quack/static/
!crates/quack/styles/

# Prebuilt binaries for Dockerfile.release
!dist/linux-amd64/quack
!dist/linux-arm64/quack
