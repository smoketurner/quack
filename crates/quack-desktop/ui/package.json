{
  "name": "quack-desktop-ui",
  "private": true,
  "description": "The desktop app's frontend, bundled into Quack.app (crates/quack-desktop)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "types": "openapi-typescript src/schema.json -o src/schema.d.ts",
    "lint": "tsc --noEmit -p tsconfig.json && eslint src && prettier --check src",
    "format": "prettier --write src",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-dialog": "2.8.2",
    "@tauri-apps/plugin-opener": "2.7.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
