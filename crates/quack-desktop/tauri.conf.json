{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quack",
  "identifier": "com.smoketurner.quack",
  "build": {
    "frontendDist": "static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "quack",
        "url": "quack://localhost/",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "A knowledge engine for your documents, tables, and graph"
  }
}
