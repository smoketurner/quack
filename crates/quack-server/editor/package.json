{
  "name": "quack-sql-editor",
  "private": true,
  "description": "The web console's SQL editor, bundled to static/js/sql-editor.min.js (make editor-build)",
  "type": "module",
  "scripts": {
    "build": "esbuild sql-editor.js --bundle --minify --format=iife --target=es2020 --legal-comments=eof --outfile=../static/js/sql-editor.min.js"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.13",
    "esbuild": "0.28.2"
  }
}
