# Environment overrides quack reads at startup. Copy to .env (gitignored) if a shell
# helper loads it; the binary itself reads the variables, not the file.

# Logging filter (tracing-subscriber syntax); the server defaults to info, the CLI to warn.
RUST_LOG=info

# Where workspaces and control.db live (default ~/.local/share/quack).
# QUACK_DATA_DIR=/data

# Where config.toml is read from (default ~/.config/quack).
# QUACK_CONFIG_DIR=/config

# Override [general].chat_model as PROVIDER/MODEL.
# QUACK_MODEL=ollama/gpt-oss:20b

# Override [server].bind for `quack serve`.
# QUACK_BIND=0.0.0.0:8080
